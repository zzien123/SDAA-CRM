{
  "name": "sdaa-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "import:file": "tsx --env-file=.env.local scripts/import-file.ts",
    "test": "tsx --env-file=.env.local --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "import:rollback": "tsx --env-file=.env.local scripts/rollback.ts",
    "entities:reclassify": "tsx --env-file=.env.local scripts/reclassify-entities.ts",
    "vercel-build": "tsx scripts/migrate.ts && next build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "geist": "^1.3.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "next": "^15.5.27",
    "papaparse": "^5.4.1",
    "postgres": "^3.4.5",
    "react": "^19.1.9",
    "react-dom": "^19.1.9",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^20",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss",
    "uuid": "11.1.1"
  }
}
